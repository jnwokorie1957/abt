# Compose reads .env from this directory. Never put this file in public/.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# sqlite is a credential-free local preview. Set firestore for the new backend.
JOIN_STORAGE=sqlite
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION=join_submissions
# Optional credential-file mount; see compose.firestore.yaml and README.md.
# GOOGLE_CREDENTIALS_FILE=/absolute/private/path/to/adc-credentials.json

# Optional notification delivery. Inquiries are always saved to SQLite first.
# SMTP uses verified TLS (465 implicit TLS; other ports STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
JOIN_TO_EMAIL=
